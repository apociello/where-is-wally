generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Map {
  id       Int    @id @default(autoincrement())
  slug     String @unique
  name     String
  imageUrl String
  width    Int
  height   Int

  placements Placement[]
  games      Game[]
}

model Character {
  id        Int    @id @default(autoincrement())
  name      String @unique
  avatarUrl String

  placements Placement[]
  foundIn    FoundCharacter[]
}

// Where a character is hidden in a map, as a box in pixels of the original image
model Placement {
  mapId       Int
  characterId Int
  xMin        Int
  yMin        Int
  xMax        Int
  yMax        Int

  map       Map       @relation(fields: [mapId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([mapId, characterId])
}

// One play of a map by an anonymous player, identified by a random UUID
model Game {
  id         String    @id @default(uuid())
  mapId      Int
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  map   Map              @relation(fields: [mapId], references: [id], onDelete: Cascade)
  found FoundCharacter[]
}

// A character the player has already found in a game
model FoundCharacter {
  gameId      String
  characterId Int
  foundAt     DateTime @default(now())

  game      Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([gameId, characterId])
}
